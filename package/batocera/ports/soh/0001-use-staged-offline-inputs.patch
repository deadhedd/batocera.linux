diff --git a/libultraship/cmake/dependencies/linux.cmake b/libultraship/cmake/dependencies/linux.cmake
--- a/libultraship/cmake/dependencies/linux.cmake
+++ b/libultraship/cmake/dependencies/linux.cmake
@@ -1,3 +1,16 @@
 #=================== ImGui ===================
 find_package(SDL2 REQUIRED)
+# SDL2's generated config can point at the build host's /usr/lib when
+# cross-compiling. Recover the imported target from the cross sysroot.
+if (NOT TARGET SDL2::SDL2)
+    find_library(SOH_SDL2_LIBRARY NAMES SDL2)
+    if (NOT SOH_SDL2_LIBRARY)
+        message(FATAL_ERROR "Could not resolve SDL2::SDL2 in the target sysroot")
+    endif()
+    add_library(SDL2::SDL2 UNKNOWN IMPORTED GLOBAL)
+    set_target_properties(SDL2::SDL2 PROPERTIES
+        IMPORTED_LOCATION "${SOH_SDL2_LIBRARY}"
+        INTERFACE_INCLUDE_DIRECTORIES "${SDL2_INCLUDE_DIRS}"
+    )
+endif()
 target_link_libraries(ImGui PUBLIC SDL2::SDL2)

@@ -4,5 +4,7 @@ if (USE_OPENGLES)
     target_link_libraries(ImGui PUBLIC ${OPENGL_GLESv2_LIBRARY})
     add_compile_definitions(IMGUI_IMPL_OPENGL_ES3)
 else()
-    target_link_libraries(ImGui PUBLIC ${OPENGL_opengl_LIBRARY})
+    if (NOT SOH_ASSET_GENERATOR_ONLY)
+        target_link_libraries(ImGui PUBLIC ${OPENGL_opengl_LIBRARY})
+    endif()
 endif()

