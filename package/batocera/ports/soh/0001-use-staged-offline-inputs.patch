diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4429cc59..ca32c8be 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -57,5 +57,16 @@ execute_process(
     OUTPUT_STRIP_TRAILING_WHITESPACE
 )
 
+# Buildroot exports Git sources without their .git directory. Keep the pinned
+# source identity supplied by the package when no local checkout is available.
+string(LENGTH "${GIT_COMMIT_HASH}" GIT_COMMIT_HASH_LENGTH)
+if(NOT GIT_COMMIT_HASH_LENGTH EQUAL 40 OR NOT GIT_COMMIT_HASH MATCHES "^[0-9a-fA-F]+$")
+    string(LENGTH "${SOH_SOURCE_COMMIT}" SOH_SOURCE_COMMIT_LENGTH)
+    if(NOT SOH_SOURCE_COMMIT_LENGTH EQUAL 40 OR NOT SOH_SOURCE_COMMIT MATCHES "^[0-9a-fA-F]+$")
+        message(FATAL_ERROR "A full SOH_SOURCE_COMMIT is required outside a Git checkout")
+    endif()
+    set(GIT_COMMIT_HASH "${SOH_SOURCE_COMMIT}")
+endif()
+
 # Get only the first 7 characters of the hash
 string(SUBSTRING "${GIT_COMMIT_HASH}" 0 7 SHORT_COMMIT_HASH)

diff --git a/CMake/Utils.cmake b/CMake/Utils.cmake
--- a/CMake/Utils.cmake
+++ b/CMake/Utils.cmake
@@ -235,5 +235,14 @@ function(get_linux_lsb_release_information)
     find_program(LSB_RELEASE_EXEC lsb_release)
     if(NOT LSB_RELEASE_EXEC)
-        message(FATAL_ERROR "Could not detect lsb_release executable, can not gather required information")
+        # Distro labels are only used in optional package metadata. Build
+        # environments do not always provide lsb_release, so keep configure
+        # usable without making that host utility a build dependency.
+        set(LSB_RELEASE_ID_SHORT "Linux")
+        set(LSB_RELEASE_VERSION_SHORT "unknown")
+        set(LSB_RELEASE_CODENAME_SHORT "unknown")
+        set(LSB_RELEASE_ID_SHORT "${LSB_RELEASE_ID_SHORT}" PARENT_SCOPE)
+        set(LSB_RELEASE_VERSION_SHORT "${LSB_RELEASE_VERSION_SHORT}" PARENT_SCOPE)
+        set(LSB_RELEASE_CODENAME_SHORT "${LSB_RELEASE_CODENAME_SHORT}" PARENT_SCOPE)
+        return()
     endif()
 
